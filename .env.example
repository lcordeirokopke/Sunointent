# Copie para .env e preencha. O .env fica fora do git.
# URL do projeto Supabase do site.
SUPABASE_URL=https://<project-ref>.supabase.co
# Chave service role: ignora RLS. Só o pipeline e o servidor do dashboard usam. Nunca versionar nem usar no navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Conexão Postgres das transações: session pooler (porta 5432) ou conexão direta.
# O pooler de transação (porta 6543) não aceita prepared statements.
SUPABASE_DB_URL=postgresql://<usuario>:<senha>@<host>:5432/postgres
# Chaves da Gemini API (Google AI Studio), usadas por sunontent/llm.py, nesta ordem de chamada.
# Principal, obrigatória: toda chamada começa por ela.
GOOGLE_API_KEY_PRINC=
# Reserva, opcional: chamada quando a principal falha por limite, indisponibilidade ou chave recusada.
GOOGLE_API_KEY_SEC=
# Chave do OpenRouter, usada só pelo juiz (M6) em sunontent/llm.py. Obrigatória e sem reserva: chave recusada é erro terminal.
API_KEY_ROUTER=
